# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# --- Chat completions (OpenAI-compatible) ---
OPENAI_API_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-...

# --- Models ---
# The Narrator decides who knows what, advances time and narrates.
# The characters only need to play themselves, so they can run on a cheaper model.
NARRATOR_MODEL=deepseek/deepseek-v4.1-flash
CHARACTER_MODEL=deepseek/deepseek-v4.1-flash

# --- Image generation (optional: room pictures, avatars) ---
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
